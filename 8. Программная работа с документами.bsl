#Область Задача1

&НаКлиенте
Процедура СоздатьДокумент(Команда)
	СоздатьДокументНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументНаСервере()
	
	//Создаем новый документ
	НовДок = Документы.ЗаказКлиента.СоздатьДокумент();
	
	//Заполняем реквизиты
	Организация = Справочники.Организации.ОсновнаяОрганизация;
	Склад = Справочники.Склады.Основной;
	Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("Агроимпульс ТД ООО");
	Договор = Справочники.ДоговорыКонтрагентов.НайтиПоКоду("00011");
	
	НовДок.Организация = Организация;
	НовДок.Склад = Склад;
	НовДок.Контрагент = Контрагент;
	НовДок.Договор = Договор;
	НовДок.Дата = ТекущаяДата();
	
	//Создаем и заполняем табличную часть
	ТабЧасть = НовДок.Товары;
	СтрокаТабЧасти = ТабЧасть.Добавить();
	
	НоменклатураХолодильник = Справочники.Номенклатура.НайтиПоНаименованию("Холодильник ATLANT ХМ 4208-000");
	СписокИменРеквизитов = "ЕдиницаИзмерения,СтавкаНДС";
	Результат = ОбщегоНазначенияВызовСервера.ПолучитьРеквизитыНоменклатуры(НоменклатураХолодильник, СписокИменРеквизитов);
	
	СтрокаТабЧасти.Номенклатура = НоменклатураХолодильник;
	СтрокаТабЧасти.ЕдиницаИзмерения = Результат.ЕдиницаИзмерения;
	СтрокаТабЧасти.СтавкаНДС = Результат.СтавкаНДС;
	СтрокаТабЧасти.Количество = 7;
	СтрокаТабЧасти.Цена = 178900;
	
	ОбработкаТабличнхЧастейСервер.РассчитатьСуммыВСтрокеТабличнойЧасти(СтрокаТабЧасти);
	
	НовДок.Записать();
	
	//1. Создать документ "Заказ клиента", заполнить реквизиты следующими значениями:
	//Организация:  "Электроник ООО"
	//Склад:		"Основной" 
	//Контрагент:	"Агроимпульс ТД ООО"
	//Договор:		"Договор № б/н от 12.10.2021"
	//***Табличная часть "Товары"***
	//Номенклатура: "Холодильник ATLANT ХМ 4208-000"
	
	//Количество: 7 шт.
	//Цена: 17900 руб.
	//***
	//Единицу измерения, ставку ндс заполнить значениями из номенклатуры
	//Суммы в строке должны быть рассчитаны по аналогии с тем, как описано в модуле формы документа
	
КонецПроцедуры

#КонецОбласти

