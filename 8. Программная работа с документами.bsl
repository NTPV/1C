&НаСервере
Процедура НайтиДокументНаСервере()
	
	//2. Найти документ "Заказ клиента" с номером "00000000003" (в этом году)
	ДокументЗаказКлиента = Документы.ЗаказКлиента.НайтиПоНомеру("00000000003", '20210101');
	Сообщить("Заказ клиента " + ДокументЗаказКлиента.Контрагент + " найден");
КонецПроцедуры

