#Область Задача3

&НаКлиенте
Процедура ИзменитьДокумент(Команда)
	ИзменитьДокументНаСервере();
КонецПроцедуры

&НаСервере
Процедура ИзменитьДокументНаСервере()
	
	//3. Изменить документ "Заказ клиента" с номером "00000000005" (в этом году):
	//Увеличить цены во всех строках табличной части "Товары" на 10% и пересчитать суммы
	ДокументСсылка = Документы.ЗаказКлиента.НайтиПоНомеру("00000000005", '20210101');
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	ТабЧасть = ДокументОбъект.Товары;
	
	Для каждого Строка из ТабЧасть Цикл
		Строка.Цена = Строка.Цена * 1.1;
		ОбработкаТабличнхЧастейСервер.РассчитатьСуммыВСтрокеТабличнойЧасти(Строка);
	КонецЦикла;
	
	ДокументОбъект.Записать();
	Сообщить("Документ успешно изменен");
	
КонецПроцедуры

#КонецОбласти

