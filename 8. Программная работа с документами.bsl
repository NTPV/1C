&НаСервере
Процедура ЗаполнитьНаОснованииНаСервере()
	
	//4. На основании документа "Заказ клиента" с номером "00000000005" создать документ "Расходная накладная"
	НовДок = Документы.РасходнаяНакладная.СоздатьДокумент();
	
	ДокументСсылкаЗаказКлиента = Документы.ЗаказКлиента.НайтиПоНомеру("00000000005", '20210101');
	
	НовДок.Заполнить(ДокументСсылкаЗаказКлиента);
	НовДок.Дата = ТекущаяДата();
	НовДок.Записать();
КонецПроцедуры

