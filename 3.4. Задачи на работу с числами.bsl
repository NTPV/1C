//1 Представить дробное число в виде суммы строкой

//***********************************
//Вариант через форматную строку
ВведенноеЧисло = 127.45;

ЦелаяЧасть = Цел(ВведенноеЧисло);
ДробнаяЧасть = ВведенноеЧисло - ЦелаяЧасть;
ЦелаяЧасть = Формат(ЦелаяЧасть, "ЧФ='Ч руб. '");
ДробнаяЧасть = Формат(ДробнаяЧасть, "ЧС=-2; ЧФ='Ч коп.'");

Сообщить(ЦелаяЧасть + ДробнаяЧасть);

//Простой вариант
ВведенноеЧисло = 357.59;

ЦелаяЧасть = Цел(ВведенноеЧисло);
ДробнаяЧасть = (ВведенноеЧисло - ЦелаяЧасть)*100;

Сообщить("" + ЦелаяЧасть + " руб. " + ДробнаяЧасть + " коп.");
